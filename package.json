{
  "name": "govea-monorepo",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "demo:start": "sh scripts/demo-start.sh",
    "demo:docker": "docker compose -f docker-compose.demo.yml up --build",
    "demo:stop": "docker compose -f docker-compose.demo.yml down"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.0.0"
}
