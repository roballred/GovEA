// GovEA — Prisma Schema
// Each EA object is a proper table (not a generic EAV schema) for
// query performance and type safety. Shared CMS-pattern metadata
// (status, audit fields) appears on every model.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth (NextAuth / Auth.js)
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?   // null for OAuth/Entra ID users
  role          String    @default("viewer") // admin | contributor | viewer
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts       Account[]
  sessions       Session[]
  organizations  Organization[]
  personas       Persona[]
  capabilities   Capability[]
  applications   Application[]
  adrs           Adr[]
  techLifecycles TechLifecycle[]
  auditLogs      AuditLog[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Organization — top-level entity (one per tenant / deployment)
// ---------------------------------------------------------------------------

model Organization {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String
  status      String   @default("published")

  name             String
  jurisdictionType String   // city | county | state | special-district | regional
  state            String   // US state abbreviation
  populationServed Int?
  eaMaturityLevel  Int      @default(1) // 1-5
  description      String?
  website          String?

  createdBy    User         @relation(fields: [createdById], references: [id])
  capabilities Capability[]
  applications Application[]
  personas     Persona[]
  adrs         Adr[]
  auditLogs    AuditLog[]   @relation("OrganizationAuditLogs")

  @@index([status])
}

// ---------------------------------------------------------------------------
// Persona — who is affected by the agency's technology
// ---------------------------------------------------------------------------

model Persona {
  id             String   @id @default(cuid())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdById    String
  status         String   @default("published")
  organizationId String

  name       String
  roleType   String   // citizen | staff | elected | external
  department String?
  goals      String?  // stored as HTML from rich text editor
  painPoints String?
  insights   String?

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User                @relation(fields: [createdById], references: [id])
  capabilities CapabilityPersona[]
  applications ApplicationPersona[]
  auditLogs    AuditLog[]          @relation("PersonaAuditLogs")

  @@index([organizationId, status])
}

// ---------------------------------------------------------------------------
// Capability — what the organization does (hierarchical)
// Every capability traces to at least one persona.
// ---------------------------------------------------------------------------

model Capability {
  id             String   @id @default(cuid())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdById    String
  status         String   @default("published")
  organizationId String

  name                String
  description         String?
  domain              String?  // from taxonomy: capability-domains
  parentId            String?
  owningDepartment    String?
  maturityLevel       String?  // Initial | Managed | Defined | Quantitatively Managed | Optimizing
  strategicImportance String?  // Core | Supporting | Enabling
  togafTag            String?  // optional TOGAF overlay
  safeTag             String?  // optional SAFe overlay

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User                @relation(fields: [createdById], references: [id])
  parent       Capability?         @relation("CapabilityHierarchy", fields: [parentId], references: [id])
  children     Capability[]        @relation("CapabilityHierarchy")
  personas     CapabilityPersona[]
  applications ApplicationCapability[]
  adrs         AdrCapability[]
  auditLogs    AuditLog[]          @relation("CapabilityAuditLogs")

  @@index([organizationId, status])
  @@index([parentId])
}

// ---------------------------------------------------------------------------
// Application — technology that enables capabilities
// Every application traces to at least one capability.
// ---------------------------------------------------------------------------

model Application {
  id             String   @id @default(cuid())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdById    String
  status         String   @default("published")
  organizationId String

  name                String
  description         String?
  vendor              String?
  version             String?
  lifecycleStatus     String   @default("current") // current | aging | sunset | decommissioned | planned
  businessCriticality String?  // critical | high | medium | low
  technicalDebtScore  Int?     // 1-5
  hostingModel        String?  // on-prem | cloud | saas | hybrid
  annualCost          Float?
  contractExpiry      DateTime?
  owningDepartment    String?
  primaryContactId    String?
  notes               String?

  organization   Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy      User                    @relation(fields: [createdById], references: [id])
  capabilities   ApplicationCapability[]
  personas       ApplicationPersona[]
  adrs           AdrApplication[]
  techLifecycles ApplicationTechLifecycle[]
  auditLogs      AuditLog[]              @relation("ApplicationAuditLogs")

  @@index([organizationId, lifecycleStatus])
  @@index([organizationId, status])
}

// ---------------------------------------------------------------------------
// Architecture Decision Record
// ---------------------------------------------------------------------------

model Adr {
  id             String   @id @default(cuid())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdById    String
  status         String   @default("proposed") // proposed | accepted | deprecated | superseded
  organizationId String

  title          String
  context        String?
  decision       String?
  consequences   String?
  arbStatus      String   @default("not-reviewed") // not-reviewed | in-review | approved | rejected
  arbFindings    String?
  supersededById String?

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User              @relation(fields: [createdById], references: [id])
  supersededBy Adr?             @relation("AdrSuperseded", fields: [supersededById], references: [id])
  supersedes   Adr[]            @relation("AdrSuperseded")
  capabilities AdrCapability[]
  applications AdrApplication[]
  auditLogs    AuditLog[]       @relation("AdrAuditLogs")

  @@index([organizationId, status])
}

// ---------------------------------------------------------------------------
// Technology Lifecycle — tracks EOL risk across the portfolio
// ---------------------------------------------------------------------------

model TechLifecycle {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String

  technologyName   String
  vendor           String?
  currentVersion   String?
  endOfSupportDate DateTime?
  endOfLifeDate    DateTime?
  riskLevel        String?  // critical | high | medium | low
  notes            String?

  createdBy    User                       @relation(fields: [createdById], references: [id])
  applications ApplicationTechLifecycle[]
  auditLogs    AuditLog[]                 @relation("TechLifecycleAuditLogs")
}

// ---------------------------------------------------------------------------
// Junction tables
// ---------------------------------------------------------------------------

model CapabilityPersona {
  capabilityId String
  personaId    String

  capability Capability @relation(fields: [capabilityId], references: [id], onDelete: Cascade)
  persona    Persona    @relation(fields: [personaId], references: [id], onDelete: Cascade)

  @@id([capabilityId, personaId])
}

model ApplicationCapability {
  applicationId String
  capabilityId  String

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  capability  Capability  @relation(fields: [capabilityId], references: [id], onDelete: Cascade)

  @@id([applicationId, capabilityId])
}

model ApplicationPersona {
  applicationId String
  personaId     String

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  persona     Persona     @relation(fields: [personaId], references: [id], onDelete: Cascade)

  @@id([applicationId, personaId])
}

model AdrCapability {
  adrId        String
  capabilityId String

  adr        Adr        @relation(fields: [adrId], references: [id], onDelete: Cascade)
  capability Capability @relation(fields: [capabilityId], references: [id], onDelete: Cascade)

  @@id([adrId, capabilityId])
}

model AdrApplication {
  adrId         String
  applicationId String

  adr         Adr         @relation(fields: [adrId], references: [id], onDelete: Cascade)
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@id([adrId, applicationId])
}

model ApplicationTechLifecycle {
  applicationId   String
  techLifecycleId String

  application   Application   @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  techLifecycle TechLifecycle @relation(fields: [techLifecycleId], references: [id], onDelete: Cascade)

  @@id([applicationId, techLifecycleId])
}

// ---------------------------------------------------------------------------
// Taxonomy — hierarchical categorization (capability domains, etc.)
// ---------------------------------------------------------------------------

model TaxonomyTerm {
  id       String @id @default(cuid())
  taxonomy String // e.g. 'capability-domains', 'lifecycle-status'
  name     String
  slug     String
  parentId String?
  order    Int    @default(0)

  parent   TaxonomyTerm?  @relation("TaxonomyHierarchy", fields: [parentId], references: [id])
  children TaxonomyTerm[] @relation("TaxonomyHierarchy")

  @@unique([taxonomy, slug])
  @@index([taxonomy])
}

// ---------------------------------------------------------------------------
// Audit Log
// ---------------------------------------------------------------------------

model AuditLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  userId    String
  action    String   // created | updated | deleted | status_changed | published | archived
  entityType String  // organization | persona | capability | application | adr | tech_lifecycle
  entityId   String
  changes    Json?   // { before, after, diff }

  user User @relation(fields: [userId], references: [id])

  // Named relations to each entity type for filtering
  organizationId  String?
  personaId       String?
  capabilityId    String?
  applicationId   String?
  adrId           String?
  techLifecycleId String?

  organization  Organization?  @relation("OrganizationAuditLogs", fields: [organizationId], references: [id])
  persona       Persona?       @relation("PersonaAuditLogs", fields: [personaId], references: [id])
  capability    Capability?    @relation("CapabilityAuditLogs", fields: [capabilityId], references: [id])
  application   Application?   @relation("ApplicationAuditLogs", fields: [applicationId], references: [id])
  adr           Adr?           @relation("AdrAuditLogs", fields: [adrId], references: [id])
  techLifecycle TechLifecycle? @relation("TechLifecycleAuditLogs", fields: [techLifecycleId], references: [id])

  @@index([entityType, entityId])
  @@index([userId])
}
