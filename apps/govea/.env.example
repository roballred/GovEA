# Database
# PostgreSQL for production/SaaS. SQLite for local dev (change provider in schema.prisma).
DATABASE_URL="postgresql://govea:govea@localhost:5432/govea"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET="your-secret-here"

# Microsoft Entra ID SSO (optional — remove these lines to disable SSO)
# ENTRA_CLIENT_ID="your-entra-client-id"
# ENTRA_CLIENT_SECRET="your-entra-client-secret"
# ENTRA_TENANT_ID="your-entra-tenant-id"

# App URL
NEXTAUTH_URL="http://localhost:3000"
